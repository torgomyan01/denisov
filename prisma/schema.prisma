generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Singleton CMS settings (menu page title/note + optional PDF).
model SiteSettings {
  id        String   @id @default("main")
  menuTitle String   @default("Меню") @db.VarChar(255)
  menuNote  String   @default("") @db.VarChar(500)
  menuPdf   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMeta {
  id          String   @id @default("main")
  title       String   @db.VarChar(255)
  description String   @db.Text
  keywords    String   @db.Text
  ogImage     String   @default("") @db.VarChar(500)
  locale      String   @default("ru_RU") @db.VarChar(16)
  updatedAt   DateTime @updatedAt
}

model SiteHero {
  id                   String   @id @default("main")
  eyebrow              String   @default("") @db.VarChar(255)
  title                String   @default("") @db.VarChar(255)
  subtitle             String   @default("") @db.Text
  metaLine             String   @default("") @db.VarChar(255)
  menuButtonLabel      String   @default("Меню") @db.VarChar(64)
  telegramButtonLabel  String   @default("Telegram") @db.VarChar(64)
  telegramUrl          String   @default("") @db.VarChar(500)
  featuredImage        String   @default("") @db.VarChar(500)
  featuredCaption      String   @default("") @db.VarChar(255)
  featuredBadge        String   @default("") @db.VarChar(64)
  updatedAt            DateTime @updatedAt
}

model SiteAbout {
  id          String   @id @default("main")
  eyebrow     String   @default("") @db.VarChar(255)
  title       String   @default("") @db.Text
  text        String   @default("") @db.Text
  stat1Value  String   @default("") @db.VarChar(64)
  stat1Label  String   @default("") @db.VarChar(64)
  stat2Value  String   @default("") @db.VarChar(64)
  stat2Label  String   @default("") @db.VarChar(64)
  stat3Value  String   @default("") @db.VarChar(64)
  stat3Label  String   @default("") @db.VarChar(64)
  updatedAt   DateTime @updatedAt
}

model SiteContacts {
  id                   String   @id @default("main")
  eyebrow              String   @default("") @db.VarChar(255)
  title                String   @default("") @db.VarChar(255)
  phone                String   @default("") @db.VarChar(64)
  addressLabel         String   @default("Адрес") @db.VarChar(64)
  address              String   @default("") @db.VarChar(255)
  hoursLabel           String   @default("Часы") @db.VarChar(64)
  hours                String   @default("") @db.VarChar(255)
  menuButtonLabel      String   @default("Меню") @db.VarChar(64)
  telegramButtonLabel  String   @default("Telegram") @db.VarChar(64)
  telegramUrl          String   @default("") @db.VarChar(500)
  image                String   @default("") @db.VarChar(500)
  updatedAt            DateTime @updatedAt
}

model SiteFooter {
  id         String   @id @default("main")
  brand      String   @default("") @db.VarChar(255)
  copyright  String   @default("") @db.VarChar(255)
  updatedAt  DateTime @updatedAt
}

model SiteBrand {
  id             String   @id @default("main")
  logo           String   @default("") @db.VarChar(500)
  /// text | image | hidden — how the logo appears in the site header
  headerLogoMode String   @default("text") @db.VarChar(16)
  updatedAt      DateTime @updatedAt
}

model Dish {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  image     String   @default("") @db.VarChar(500)
  caption   String   @default("") @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive, sortOrder])
}

/// Legacy local menu (unused). Site menu comes from iiko + IikoMenuOverride.
model MenuCategory {
  id            String     @id @default(cuid())
  sortOrder     Int        @default(0)
  name          String     @default("") @db.VarChar(255)
  availableFrom String     @default("") @db.VarChar(8)
  availableTo   String     @default("") @db.VarChar(8)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         MenuItem[]

  @@index([sortOrder])
  @@index([isActive, sortOrder])
}

/// Legacy local menu items (unused).
model MenuItem {
  id              String       @id @default(cuid())
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder       Int          @default(0)
  name            String       @default("") @db.VarChar(255)
  description     String       @default("") @db.Text
  price           String       @default("") @db.VarChar(64)
  image           String       @default("") @db.VarChar(500)
  weight          String       @default("") @db.VarChar(64)
  kcal            Float?
  protein         Float?
  fat             Float?
  carbs           Float?
  showInDelivery  Boolean      @default(true)
  inStock         Boolean      @default(true)
  showInUpsell    Boolean      @default(false)
  upsellSortOrder Int          @default(0)
  iikoProductId   String       @default("") @db.VarChar(64)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId, sortOrder])
  @@index([isActive])
  @@index([showInDelivery, inStock])
  @@index([showInUpsell, upsellSortOrder])
}

/// Local order + visibility for iiko menu categories (keyed by iiko group id).
model IikoCategoryOverride {
  iikoCategoryId String  @id @db.VarChar(64)
  /// Lower = higher on site / in admin list
  sortOrder      Int     @default(0)
  showOnSite     Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
  @@index([showOnSite])
}

/// Daily snapshot of iiko external menu (full catalog JSON). Refreshed at most once/day.
model IikoMenuCache {
  id          String   @id @default("main")
  menuId      String   @default("") @db.VarChar(64)
  menuName    String   @default("") @db.VarChar(255)
  /// Serialized IikoCatalog
  payloadJson String   @db.LongText
  fetchedAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Local overrides / flags for iiko external-menu products (keyed by iiko productId).
/// Empty name/description/price/weight/image → show value from iiko.
model IikoMenuOverride {
  iikoProductId   String   @id @db.VarChar(64)
  name            String   @default("") @db.VarChar(255)
  description     String   @default("") @db.Text
  price           String   @default("") @db.VarChar(64)
  image           String   @default("") @db.VarChar(500)
  weight          String   @default("") @db.VarChar(64)
  kcal            Float?
  protein         Float?
  fat             Float?
  carbs           Float?
  showInDelivery  Boolean  @default(true)
  inStock         Boolean  @default(true)
  showInUpsell    Boolean  @default(false)
  upsellSortOrder Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([showInDelivery, inStock])
  @@index([showInUpsell, upsellSortOrder])
}

/// Singleton delivery section settings (banner, fees, legacy zone, orders toggle).
model DeliverySettings {
  id               String   @id @default("main")
  bannerDesktop    String   @default("") @db.VarChar(500)
  bannerMobile     String   @default("") @db.VarChar(500)
  title            String   @default("Доставка из Денисова") @db.VarChar(255)
  subtitle         String   @default("") @db.VarChar(500)
  ordersEnabled    Boolean  @default(true)
  /// Fallback min cart ₽ when no multi-zones (or zone min is 0).
  minOrderAmount   Int      @default(0)
  /// Fallback fee when multi-zones are not configured.
  deliveryFee      Int      @default(0)
  /// Fallback free-from threshold when multi-zones are not configured.
  freeDeliveryFrom Int      @default(0)
  /// Legacy: radius | polygon (used only if DeliveryZone rows are empty)
  zoneMode         String   @default("radius") @db.VarChar(16)
  zoneRadiusKm     Float    @default(5)
  zoneCenterLat    Float?
  zoneCenterLng    Float?
  /// Legacy single polygon JSON [lat, lng][]
  zonePolygonJson  String   @default("[]") @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Admin-drawn delivery coverage polygons with per-zone pricing.
model DeliveryZone {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(120)
  /// Stroke / fill brand color (#RRGGBB)
  color            String   @default("#9C6B4A") @db.VarChar(16)
  /// JSON array of [lat, lng] ring (closed or open)
  polygonJson      String   @db.Text
  deliveryFee      Int      @default(0)
  /// Free delivery from this cart total (₽). 0 = disabled for the zone.
  freeDeliveryFrom Int      @default(0)
  /// Min cart ₽ for this zone. 0 = use DeliverySettings.minOrderAmount.
  minOrderAmount   Int      @default(0)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum FulfillmentMode {
  pickup
  delivery
}

enum CustomerRole {
  customer
  courier
}

/// Site guest / delivery customer (phone register or Yandex ID).
model Customer {
  id               String            @id @default(cuid())
  /// First name
  name             String            @default("") @db.VarChar(255)
  surname          String            @default("") @db.VarChar(255)
  phone            String?           @unique @db.VarChar(32)
  email            String?           @unique @db.VarChar(255)
  birthday         DateTime?
  yandexId         String?           @unique @db.VarChar(64)
  /// scrypt salt:hash — null for Yandex-only accounts
  passwordHash     String?           @db.VarChar(255)
  /// customer = site guest; courier = can scan & hand over orders
  role             CustomerRole      @default(customer)
  /// Default address for delivery orders
  deliveryAddress  String?           @db.VarChar(500)
  /// Saved door details — reused on next delivery checkout
  deliveryApartment String?          @db.VarChar(64)
  deliveryEntrance  String?          @db.VarChar(64)
  deliveryFloor     String?          @db.VarChar(32)
  deliveryIntercom  String?          @db.VarChar(64)
  /// Last courier note (prefill only; each order stores its own copy)
  deliveryCourierComment String?     @db.VarChar(500)
  /// Saved delivery point on the map (WGS84)
  deliveryLat      Float?
  deliveryLng      Float?
  /// Preferred pickup point (active PickupPoint id)
  pickupPointId    String?           @db.VarChar(64)
  /// How the guest prefers to receive orders
  fulfillmentMode  FulfillmentMode   @default(pickup)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions           CustomerSession[]
  cart               CustomerCart?
  orders             Order[]
  pushSubscriptions  PushSubscription[]

  @@index([phone])
  @@index([email])
  @@index([role])
}

/// Browser Web Push subscription (one row per device / browser).
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Push service endpoint URL
  endpoint   String   @unique @db.VarChar(2048)
  p256dh     String   @db.VarChar(255)
  auth       String   @db.VarChar(255)
  userAgent  String   @default("") @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

/// Aligned 1:1 with iiko Cloud `DeliveryStatus`.
enum OrderStatus {
  Unconfirmed
  WaitCooking
  ReadyForCooking
  CookingStarted
  CookingCompleted
  Waiting
  OnWay
  Delivered
  Closed
  Cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
}

/// Placed customer order (pickup or delivery).
model Order {
  id                  String          @id @default(cuid())
  /// Human-readable code, e.g. D-A1B2C3
  number              String          @unique @db.VarChar(32)
  customerId          String?
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String          @default("") @db.VarChar(255)
  customerPhone       String          @default("") @db.VarChar(32)
  customerEmail       String          @default("") @db.VarChar(255)
  fulfillmentMode     FulfillmentMode @default(pickup)
  status              OrderStatus     @default(Unconfirmed)
  paymentStatus       PaymentStatus   @default(pending)
  /// card_test for now; real gateway later
  paymentMethod       String          @default("card_test") @db.VarChar(32)
  /// Total in rubles (integer) — items + delivery fee
  totalRub            Int             @default(0)
  /// Delivery fee portion of total (0 for pickup)
  deliveryFeeRub      Int             @default(0)
  utensils            Int             @default(0)
  comment             String          @default("") @db.VarChar(500)
  pickupPointId       String?         @db.VarChar(64)
  pickupPointName     String          @default("") @db.VarChar(255)
  pickupPointAddress  String          @default("") @db.VarChar(500)
  deliveryAddress     String          @default("") @db.VarChar(500)
  deliveryApartment   String          @default("") @db.VarChar(64)
  deliveryEntrance    String          @default("") @db.VarChar(64)
  deliveryFloor       String          @default("") @db.VarChar(32)
  deliveryIntercom    String          @default("") @db.VarChar(64)
  /// Comment for the courier (this order only)
  deliveryCourierComment String       @default("") @db.VarChar(500)
  deliveryLat         Float?
  deliveryLng         Float?
  /// asap | scheduled
  timeMode            String          @default("asap") @db.VarChar(16)
  scheduledAt         DateTime?
  paidAt              DateTime?
  fulfilledAt         DateTime?
  /// iiko Cloud delivery order id (UUID), set after /api/1/deliveries/create
  iikoOrderId         String?         @unique @db.VarChar(64)
  iikoCorrelationId   String?         @db.VarChar(64)
  /// Success | InProgress | Error | skipped | pending
  iikoCreationStatus  String          @default("") @db.VarChar(32)
  iikoSyncError       String          @default("") @db.VarChar(500)
  statusUpdatedAt     DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  items               OrderItem[]
  statusLogs          OrderStatusLog[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([iikoOrderId])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String @db.VarChar(64)
  name         String @db.VarChar(255)
  price        String @default("") @db.VarChar(64)
  image        String @default("") @db.VarChar(500)
  categoryId   String @default("") @db.VarChar(64)
  categoryName String @default("") @db.VarChar(255)
  qty          Int    @default(1)
  /// Line total in rubles
  lineTotalRub Int    @default(0)
  /// JSON: selected iiko modifiers [{groupId,productId,name,amount}]
  modifiersJson String @default("[]") @db.VarChar(2000)

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("") @db.VarChar(255)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

/// Persistent shopping cart for a logged-in customer.
model CustomerCart {
  id              String             @id @default(cuid())
  customerId      String             @unique
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  utensils        Int                @default(0)
  comment         String             @default("") @db.VarChar(500)
  fulfillmentMode FulfillmentMode    @default(pickup)
  pickupPointId   String?            @db.VarChar(64)
  deliveryAddress String             @default("") @db.VarChar(500)
  deliveryLat     Float?
  deliveryLng     Float?
  /// asap | scheduled
  timeMode        String             @default("asap") @db.VarChar(16)
  scheduledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           CustomerCartItem[]
}

model CustomerCartItem {
  id           String       @id @default(cuid())
  cartId       String
  cart         CustomerCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String       @db.VarChar(64)
  /// productId + modifier fingerprint (unique per cart row)
  lineKey      String       @default("") @db.VarChar(255)
  name         String       @db.VarChar(255)
  price        String       @default("") @db.VarChar(64)
  image        String       @default("") @db.VarChar(500)
  categoryId   String       @default("") @db.VarChar(64)
  categoryName String       @default("") @db.VarChar(255)
  qty          Int          @default(1)
  /// JSON: selected iiko modifiers
  modifiersJson String      @default("[]") @db.VarChar(2000)

  @@unique([cartId, lineKey])
  @@index([cartId])
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @db.VarChar(128)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

/// Cafe / pickup location for self-pickup orders.
model PickupPoint {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  phone     String   @default("") @db.VarChar(32)
  address   String   @db.VarChar(500)
  /// WGS84 latitude
  lat       Float
  /// WGS84 longitude
  lng       Float
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([sortOrder])
}
